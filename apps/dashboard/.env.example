# Copy to .env.local locally. Never commit real keys or send passwords in chat.
# Use one Clerk application instance's matching keys, issuer and owner ID.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SIGNALTRAIL_OWNER_CLERK_USER_ID=
# Exact HTTPS issuer from this Clerk instance's verified session token, no slash.
SIGNALTRAIL_CLERK_ISSUER=
# Exact application origin. Loopback HTTP is allowed for local development.
SIGNALTRAIL_DASHBOARD_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard

# Server-only analytics reads. No public ingestion key authorizes dashboard reads.
# Use restricted read-only database users; never point these at public clients.
SIGNALTRAIL_CLICKHOUSE_READ_URL=http://127.0.0.1:8123
SIGNALTRAIL_CLICKHOUSE_READ_USER=
SIGNALTRAIL_CLICKHOUSE_READ_PASSWORD=
SIGNALTRAIL_MEMBERSHIP_DATABASE_URL=
# TLS is required except for explicitly configured loopback development services.
SIGNALTRAIL_MEMBERSHIP_TLS=true
# Optional PEM CA for private PostgreSQL certificates; verification stays enabled.
# SIGNALTRAIL_MEMBERSHIP_CA=
