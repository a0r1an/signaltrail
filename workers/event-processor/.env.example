# Development only. Export these variables before starting the worker.
# Provision both topics and apply infra/clickhouse/001-analytics-events.sql first.
SIGNALTRAIL_REDPANDA_BROKERS=127.0.0.1:19092
SIGNALTRAIL_REDPANDA_TOPIC=signaltrail.analytics.v1
SIGNALTRAIL_REDPANDA_DLQ_TOPIC=signaltrail.analytics.dlq.v1
SIGNALTRAIL_PROCESSOR_GROUP_ID=signaltrail-event-processor-dev
SIGNALTRAIL_CLICKHOUSE_URL=http://127.0.0.1:8123
SIGNALTRAIL_CLICKHOUSE_DATABASE=signaltrail
SIGNALTRAIL_CLICKHOUSE_TABLE=analytics_events
SIGNALTRAIL_CLICKHOUSE_USERNAME=signaltrail
SIGNALTRAIL_CLICKHOUSE_PASSWORD=signaltrail_local
SIGNALTRAIL_CLICKHOUSE_TIMEOUT_MS=5000

# Optional local-only metrics endpoint; disabled when omitted.
# SIGNALTRAIL_PROCESSOR_METRICS_PORT=9466
