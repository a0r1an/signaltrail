{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "SignalTrail capacity tests",
  "uid": "signaltrail-capacity",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Isolated test telemetry. Select a run and test time window. No production capacity guarantee; gaps and stale samples are not healthy zeros.",
  "tags": ["signaltrail", "capacity", "test"],
  "panels": [
    {
      "id": 1,
      "title": "Configured HTTP / pool / query limits",
      "description": "Outstanding query limit includes executing and acquiring/waiting work.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_configured_http_requests{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "HTTP requests / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "signaltrail_capacity_configured_metadata_connections{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "DB connections / {{run_id}}",
          "range": true
        },
        {
          "refId": "C",
          "expr": "signaltrail_capacity_configured_metadata_queries{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Total DB queries / {{run_id}}",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Offered and completed events / second",
      "description": "Completion counters include retries/attempts; unique storage reconciliation is separate.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_offered_events_per_second{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Offered / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(signaltrail_publications_completed_total{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])",
          "legendFormat": "Broker completed / {{run_id}}",
          "range": true
        },
        {
          "refId": "C",
          "expr": "rate(signaltrail_processor_stored_total{job=\"signaltrail-capacity-processor\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])",
          "legendFormat": "Processor stored attempts / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Refusals / second \u2014 HTTP vs database",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(signaltrail_capacity_http_refused_total{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])",
          "legendFormat": "HTTP admission / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(signaltrail_capacity_metadata_refused_total{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])",
          "legendFormat": "DB outstanding-query gate / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP p95 / p99 duration",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, run_id) (rate(signaltrail_http_request_duration_seconds_bucket{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])))",
          "legendFormat": "p95 / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, run_id) (rate(signaltrail_http_request_duration_seconds_bucket{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])))",
          "legendFormat": "p99 / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Database work and configured capacity",
      "description": "Pool waiting is a subset of acquiring. Instantaneous occupancy can miss spikes; peak is retained for the adapter lifetime.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_metadata_executing{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Executing / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "signaltrail_capacity_metadata_waiting{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Pool waiting / {{run_id}}",
          "range": true
        },
        {
          "refId": "C",
          "expr": "signaltrail_capacity_metadata_acquiring{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Acquiring (includes setup) / {{run_id}}",
          "range": true
        },
        {
          "refId": "D",
          "expr": "signaltrail_capacity_metadata_in_flight{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Total outstanding / {{run_id}}",
          "range": true
        },
        {
          "refId": "E",
          "expr": "signaltrail_capacity_metadata_capacity{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Total limit / {{run_id}}",
          "range": true
        },
        {
          "refId": "F",
          "expr": "signaltrail_capacity_metadata_peak_in_flight{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Retained peak outstanding / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Database acquisition / execution p99",
      "description": "Acquisition includes setup and pool wait. Execution is client round-trip time, including scheduling and failures, not server-only SQL time.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, phase, run_id) (rate(signaltrail_capacity_metadata_duration_seconds_bucket{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])))",
          "legendFormat": "{{phase}} / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Assigned CPU busy fraction",
      "description": "Linux VM logical CPU accounting; idle and iowait excluded from busy. Not whole-macOS CPU.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - sum by (cpu, run_id) (rate(signaltrail_capacity_cpu_ticks_total{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\",mode=~\"idle|iowait\",cpu=~\"$cpu\"}[1m])) / sum by (cpu, run_id) (rate(signaltrail_capacity_cpu_ticks_total{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\",cpu=~\"$cpu\"}[1m]))",
          "legendFormat": "{{cpu}} / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Container CPU cores \u2014 services and generator",
      "description": "Docker-displayed samples are sequential, approximate observations.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_container_cpu_cores{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "{{service}} / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "CPU scheduling pressure",
      "description": "Runnable work waiting for CPU. App scope covers ingestion and processor together; VM scope includes other VM work.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(signaltrail_capacity_pressure_stall_seconds_total{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\",resource=\"cpu\"}[1m])",
          "legendFormat": "{{scope}} {{level}} / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "App CPU quota throttling",
      "description": "Distinct from scheduler contention. Zero throttling does not imply CPU availability.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(signaltrail_capacity_cpu_throttled_seconds_total{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])",
          "legendFormat": "{{service}} / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "title": "Ingestion event loop",
      "description": "Interval histogram retains maxima between scrapes; it is not the distribution of individual request delays.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_nodejs_eventloop_lag_max_seconds{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Default collector max / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by(le,run_id)(rate(signaltrail_capacity_interval_loop_max_seconds_bucket{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])))",
          "legendFormat": "p99 of one-second interval maxima / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "title": "Ingestion GC p99 / GC seconds per second",
      "description": "Observed GC duration includes time effects under contention; not proof GC alone caused a pause.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by(le,run_id)(rate(signaltrail_nodejs_gc_duration_seconds_bucket{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])))",
          "legendFormat": "GC p99 / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by(run_id)(rate(signaltrail_nodejs_gc_duration_seconds_sum{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "GC seconds/sec / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "title": "Service displayed memory and hard limits",
      "description": "Displayed Docker memory excludes some cache. Generator is outside target memory budget and has no displayed limit series.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_container_displayed_memory_bytes{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "{{service}} displayed / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "signaltrail_capacity_memory_limit_bytes{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "{{service}} limit / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 14,
      "title": "ClickHouse charged memory and cap",
      "description": "Cgroup charge includes cache/kernel memory that Docker display may subtract. Reclaim can occur without OOM.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_memory_current_bytes{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\",service=\"clickhouse\"}",
          "legendFormat": "Charged memory / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "signaltrail_capacity_memory_limit_bytes{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\",service=\"clickhouse\"}",
          "legendFormat": "Hard cap / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 15,
      "title": "ClickHouse memory breakdown",
      "description": "Kernel includes slab; do not sum kernel and slab components as independent totals.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_memory_stat_bytes{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "{{kind}} / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 16,
      "title": "Memory limit / OOM events",
      "description": "Max counts attempted crossings/reclaim pressure, not lost events or OOM kills. App and ClickHouse cgroups only.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(signaltrail_capacity_memory_events_total{job=~\"signaltrail-capacity(-host)?\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\",event=~\"high|max|oom|oom_kill\"}[1m])",
          "legendFormat": "{{job}} {{service}} {{event}} / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 17,
      "title": "Memory and I/O pressure",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(signaltrail_capacity_pressure_stall_seconds_total{job=~\"signaltrail-capacity(-host)?\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\",resource=~\"memory|io\"}[1m])",
          "legendFormat": "{{job}} {{scope}} {{resource}} {{level}} / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 18,
      "title": "PostgreSQL observed backend waits",
      "description": "One-second snapshots may miss brief waits. Idle ClientRead means the server is waiting for the client.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_postgres_backends{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "{{state}} {{wait_type}} / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 19,
      "title": "Source lag and processor retries",
      "description": "Lag is records; retry rate is attempts/sec. Use final accepted/stored counts for unique-event reconciliation.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_source_lag_records{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Committed source lag / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(signaltrail_processor_retries_total{job=\"signaltrail-capacity-processor\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])",
          "legendFormat": "Processor retries/sec / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 20,
      "title": "Processor storage-write p99",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 72
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by(le,outcome,run_id)(rate(signaltrail_processor_storage_write_duration_seconds_bucket{job=\"signaltrail-capacity-processor\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])))",
          "legendFormat": "{{outcome}} / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 21,
      "title": "Latest completed stage reconciliation",
      "description": "Populated after a stage completes, not a live unique-event counter. Ambiguous outcomes can prevent exact reconciliation.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 80
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_accepted_events{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Accepted / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "signaltrail_capacity_unique_stored_events{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Unique stored / {{run_id}}",
          "range": true
        },
        {
          "refId": "C",
          "expr": "signaltrail_capacity_generator_dropped_iterations{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Generator dropped iterations / {{run_id}}",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 22,
      "title": "Run active",
      "description": "1 while the run owns the fixture; 0 on completion before target withdrawal. Setup is included.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 80
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_run_active{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "{{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 23,
      "title": "Run start / end timestamps",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 88
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_run_started_timestamp_seconds{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"} * 1000",
          "legendFormat": "Started / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "(signaltrail_capacity_run_ended_timestamp_seconds{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"} > 0) * 1000",
          "legendFormat": "Ended / {{run_id}}",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 24,
      "title": "Scrape availability",
      "description": "A missing series is not healthy. Capacity targets are withdrawn on cleanup; inspect the test time window.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 88
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"signaltrail-capacity.*\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "{{job}} / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 25,
      "title": "Telemetry age",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 96
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - signaltrail_capacity_interval_last_timestamp_seconds{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "One-second observer age / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "time() - signaltrail_capacity_sample_last_timestamp_seconds{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Docker sample age / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 26,
      "title": "Collector availability and collection duration",
      "description": "Unavailable values are explicit; each sample spans time rather than being an atomic snapshot.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 96
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signaltrail_capacity_postgres_observation_available{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "PG observation available / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "signaltrail_capacity_interval_collection_seconds{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Interval collection seconds / {{run_id}}",
          "range": true
        },
        {
          "refId": "C",
          "expr": "signaltrail_capacity_sample_collection_seconds{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}",
          "legendFormat": "Docker sample collection seconds / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 27,
      "title": "Runtime CPU by process",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 104
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(signaltrail_process_cpu_user_seconds_total{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m]) + rate(signaltrail_process_cpu_system_seconds_total{job=\"signaltrail-capacity\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])",
          "legendFormat": "Ingestion / {{run_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(signaltrail_processor_process_cpu_user_seconds_total{job=\"signaltrail-capacity-processor\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m]) + rate(signaltrail_processor_process_cpu_system_seconds_total{job=\"signaltrail-capacity-processor\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])",
          "legendFormat": "Processor / {{run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 28,
      "title": "Processor GC p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 104
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by(le,run_id)(rate(signaltrail_processor_nodejs_gc_duration_seconds_bucket{job=\"signaltrail-capacity-processor\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[1m])))",
          "legendFormat": "GC p99 / {{run_id}}",
          "range": true
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "profile",
        "label": "Test profile",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"signaltrail-capacity-host\",environment=\"test\"}, profile)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "run_id",
        "label": "Test run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\"}, run_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "cpu",
        "label": "Logical CPUs",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(signaltrail_capacity_cpu_ticks_total{environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}, cpu)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": ["cpu0", "cpu1"],
          "value": ["cpu0", "cpu1"]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Run completion",
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "expr": "changes(signaltrail_capacity_run_active{job=\"signaltrail-capacity-host\",environment=\"test\",profile=~\"$profile\",run_id=~\"$run_id\"}[15s]) > 0",
        "step": "15s",
        "titleFormat": "Run completed",
        "textFormat": "{{profile}} / {{run_id}}",
        "tagKeys": "profile,run_id"
      }
    ]
  }
}
