{
  "name": "@signaltrail/browser-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint src e2e *.config.ts --max-warnings 0",
    "harness:build": "pnpm --filter @signaltrail/contracts build && pnpm build && tsup --config e2e/bundle.config.ts",
    "harness:serve": "node e2e/server.ts",
    "harness": "pnpm harness:build && pnpm harness:serve",
    "test:browser": "pnpm harness:build && playwright test"
  },
  "dependencies": {
    "@signaltrail/contracts": "workspace:*",
    "idb": "^8.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@signaltrail/typescript-config": "workspace:*",
    "@types/node": "^24.19.0",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
