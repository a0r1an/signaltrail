{
  "name": "@signaltrail/analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side project-scoped analytics reads",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api-types": {
      "types": "./dist/api-types.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/api-types.ts --format esm --dts --clean && pnpm api:types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "pnpm api:check && eslint src tests --max-warnings 0",
    "api:generate": "openapi-typescript ../../docs/api/analytics.openapi.json -o src/generated/query-api.ts",
    "api:check": "openapi-typescript ../../docs/api/analytics.openapi.json -o src/generated/query-api.ts --check",
    "api:types": "tsc --noEmit -p tests/types/tsconfig.json"
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@readme/openapi-parser": "^10.0.0",
    "@signaltrail/typescript-config": "workspace:*",
    "@types/node": "^24.19.0",
    "ajv": "^8.20.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
