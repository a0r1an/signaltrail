{
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "SignalTrail Next.js",
    "extends": "./base.json",
    "compilerOptions": {
      "lib": ["DOM", "DOM.Iterable", "ES2022"],
      "allowJs": true,
      "noEmit": true,
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "isolatedModules": true,
      "jsx": "react-jsx",
      "incremental": true,
      "plugins": [{ "name": "next" }]
    }
  }