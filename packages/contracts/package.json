{
  "name": "@signaltrail/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared runtime schemas and TypeScript contracts for SignalTrail",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@signaltrail/typescript-config": "workspace:*",
    "@types/node": "^24.19.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}